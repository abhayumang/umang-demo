# Isko copy karke .env bana lijiye:  cp .env.example .env
# MinIO ke woh credentials jo aapne apna MinIO container chalate waqt diye the
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=umang-artifacts

# Ye dept/tomcat-users.xml se match hona chahiye
TOMCAT_USER=deployer
TOMCAT_PASSWORD=deployer123
